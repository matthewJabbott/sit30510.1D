<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_share"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="@android:color/white" />

    <TextView android:id="@+id/tv_share_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
    <TextView android:id="@+id/tv_share_interests" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/tv_share_level" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>

    <ImageView android:id="@+id/iv_qr_code" android:layout_width="200dp" android:layout_height="200dp" android:layout_gravity="center" android:layout_marginTop="24dp"/>
    <TextView android:id="@+id/tv_share_url" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="8dp" android:textSize="12sp"/>

    <Button android:id="@+id/btn_share" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Share Profile" android:layout_marginTop="24dp"/>
</LinearLayout>